    <crm:P67i_is_referred_to_by>
      <crm:E33_Linguistic_Object rdf:about="urn:uuid:564b58f3-a7c5-5f07-ab94-14c52d401875">
        <rdfs:label>US positva localizzata a SO di US 1011, caratterizzata dalla presenza di numerosi frammenti di intonaco che conservano la pellicola pittorica rivolta verso l'alto. La pellicola pittorica si presenta a fondo nero e con decorazioni sovradipinte a fasce bianche e rosse. Oltre all'intonaco restituisce laterizi e due frammenti ceramici</rdfs:label>
        <crm:P2_has_type rdf:resource="http://www.lynx.com/resource/descrizione"/>
      </crm:E33_Linguistic_Object>
    </crm:P67i_is_referred_to_by>
