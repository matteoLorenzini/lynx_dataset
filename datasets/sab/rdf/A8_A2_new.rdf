    <crm:P67i_is_referred_to_by>
      <crm:E33_Linguistic_Object rdf:about="urn:uuid:c344d424-440f-5a31-8656-1716fa68bbd2">
        <rdfs:label>US positiva, posta ad E di US 1054. Restituisce spicchi di colonna misti a poca terra sabbiosa incoerente di colore marrone chiaro. Quattro spicchi presentano parte di bollo di Domizio Calvino, facendo ipotizzare un riutilizzo del materiale di tegole bollate (RPT 4). Sembrerebbe avere un andamento O-E.</rdfs:label>
        <crm:P2_has_type rdf:resource="http://www.lynx.com/resource/descrizione"/>
      </crm:E33_Linguistic_Object>
    </crm:P67i_is_referred_to_by>
