        </crm:P7_took_place_at>
        <crm:P14_carried_out_by>
          <crm:E74_Group rdf:about="http://www.lynx.com/resource/group/rome-soprintendenza">
            <rdfs:label>Rome Soprintendenza</rdfs:label>
          </crm:E74_Group>
        </crm:P14_carried_out_by>
        <crm:P67i_is_referred_to_by>
          <crm:E33_Linguistic_Object rdf:about="http://www.lynx.com/resource/person/1000/timeline/084a041899e5/source-text">
            <rdfs:label>In the 1970s and 1980s, he tracked the Rome Soprintendenza's excavations at Tiberius's Villa in Sperlonga, producing complex reconstructions of the Hellenistic-Roman sculpture groups.</rdfs:label>
            <crm:P2_has_type rdf:resource="http://www.lynx.com/resource/source-text"/>
          </crm:E33_Linguistic_Object>
        </crm:P67i_is_referred_to_by>
      </crm:E7_Activity>
    </crm:P11i_took_part_in>
