          <crm:E33_Linguistic_Object rdf:about="http://www.lynx.com/resource/person/1000/timeline/ea0859397a6a/source-text">
            <rdfs:label>His contributions to Neue Forschungen in Pompeji (1974) and a new edition of the Alexander Mosaic (1977) reflect his focus on Roman painting and Late Republican/Early Imperial classicism.</rdfs:label>
            <crm:P2_has_type rdf:resource="http://www.lynx.com/resource/source-text"/>
          </crm:E33_Linguistic_Object>
