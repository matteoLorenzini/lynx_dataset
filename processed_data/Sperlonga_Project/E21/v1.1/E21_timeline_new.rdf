            <rdfs:label>In 1962, he completed his habilitation in Bonn with a monograph on Roman funerary art ("Studien zur roemischen Grabkunst"), dedicated to his mentors Friedrich Matz, Reinhard Herbig, and Ernst Langlotz.</rdfs:label>
            <crm:P2_has_type rdf:resource="http://www.lynx.com/resource/source-text"/>
          </crm:E33_Linguistic_Object>
        </crm:P67i_is_referred_to_by>
      </crm:E65_Creation>
    </crm:P14i_performed>
    <crm:P14i_performed>
