        <crm:P4_has_time-span>
          <crm:E52_Time-Span rdf:about="http://www.lynx.com/resource/person/1000/timeline/492e0f3a4765/time-span">
            <rdfs:label>1982</rdfs:label>
            <crm:P82a_begin_of_the_begin>1982-01-01</crm:P82a_begin_of_the_begin>
