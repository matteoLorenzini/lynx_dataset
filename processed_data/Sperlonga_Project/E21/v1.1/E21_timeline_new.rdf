        <crm:P67i_is_referred_to_by>
          <crm:E33_Linguistic_Object rdf:about="http://www.lynx.com/resource/person/1000/timeline/492e0f3a4765/source-text">
            <rdfs:label>On these themes, he published "Odysseus: Archäologie des europäischen Mythos" (1982: https://archive.org/details/laokoonunddiegru0000andr/page/n5/mode/2up ; Italian trans. "L’immagine di Ulisse", Einaudi 1983, trans. Giorgio Bejor), illustrating the mythic-cultural meaning of the Sperlonga group, and "Laokoon und die Gründung Roms" (1988; Italian trans. "Laocoonte e la fondazione di Roma", Il Saggiatore 1989).</rdfs:label>
            <crm:P2_has_type rdf:resource="http://www.lynx.com/resource/source-text"/>
          </crm:E33_Linguistic_Object>
        </crm:P67i_is_referred_to_by>
      </crm:E65_Creation>
